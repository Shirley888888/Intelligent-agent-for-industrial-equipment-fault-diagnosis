[
  {
    "kb_id": "KB-017",
    "chunk_id": "KB-017-C000",
    "text": "当油温持续升高但负载变化不大时，应重点关注散热能力是否下降。"
  },
  {
    "kb_id": "KB-018",
    "chunk_id": "KB-018-C000",
    "text": "可进一步检查冷却风扇、油泵运行状态以及散热通道是否受阻。"
  },
  {
    "kb_id": "KB-022",
    "chunk_id": "KB-022-C000",
    "text": "若温度出现瞬时跳变，应排查传感器接线与采样异常。"
  },
  {
    "kb_id": "KB-031",
    "chunk_id": "KB-031-C000",
    "text": "持续过载可能导致油温逐步升高。"
  },
  {
    "kb_id": "KB-044",
    "chunk_id": "KB-044-C000",
    "text": "振动异常需要检查机械连接和轴承状态。"
  },
  {
    "kb_id": "KB-026",
    "chunk_id": "KB-026-C000",
    "text": "冷却风扇停转或异常会降低散热能力，并可能导致油温继续升高。"
  }
]